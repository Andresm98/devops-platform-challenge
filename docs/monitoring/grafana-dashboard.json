{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "gauge",
      "title": "Disponibilidad del Servicio (%)",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        { "expr": "up{job='kubernetes-pods'} * 100", "instant": true, "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 100, "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 100 }
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Tasa de Peticiones (Throughput)",
      "gridPos": { "h": 6, "w": 9, "x": 6, "y": 0 },
      "id": 2,
      "targets": [
        { "expr": "rate(http_server_requests_seconds_count[1m])", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latencia Promedio de Respuestas",
      "gridPos": { "h": 6, "w": 9, "x": 15, "y": 0 },
      "id": 3,
      "targets": [
        { "expr": "rate(http_server_requests_seconds_sum[1m]) / rate(http_server_requests_seconds_count[1m])", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries",
      "title": "Uso de CPU por Pod (Límite HPA)",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 6 },
      "id": 4,
      "targets": [
        { "expr": "sum(rate(container_cpu_usage_seconds_total{container='devops-service'}[5m])) by (pod)", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tasa de Errores HTTP 5xx (Incident Detection)",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 6 },
      "id": 5,
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[1m]))", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "red" } } }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["production", "devops-challenge"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Production SRE Dashboard - Microservice",
  "version": 1
}